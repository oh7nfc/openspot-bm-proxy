[Unit]
Description=openSPOT BrandMeister API v2 web proxy
After=network-online.target
Wants=network-online.target

[Service]
User=openspotproxy
Group=openspotproxy
EnvironmentFile=/etc/default/openspot-bm-proxy
ExecStart=/usr/bin/python3 /opt/openspot-bm-proxy/proxy.py --device ${OPENSPOT_DEVICE} --bind ${BIND} --port ${PORT}
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/openspot-bm-proxy

[Install]
WantedBy=multi-user.target
